# Copy to `.env.local` and fill in. All values are optional.

# Repository link shown in the footer.
VITE_GITHUB_URL=https://github.com/Churious/pokenow

# Google AdSense publisher id. Leave empty in development: no ad slots are
# rendered and the AdSense script is never requested.
VITE_ADSENSE_CLIENT=
# Ad unit slot ids (numbers from AdSense → Ads → By ad unit).
VITE_AD_SLOT_TOP=
VITE_AD_SLOT_INFEED=
VITE_AD_SLOT_ANCHOR=
# Desktop sidebar 300x250 unit (sticky on screens ≥1024px).
VITE_AD_SLOT_SIDEBAR=
# In-feed units require the layout key shown in the AdSense code snippet.
VITE_AD_INFEED_LAYOUT_KEY=

# Cookie-free analytics (pick one). Cloudflare Web Analytics token, or GoatCounter site code
# (GoatCounter's hosted free tier is for non-commercial sites).
VITE_CF_ANALYTICS_TOKEN=
VITE_GOATCOUNTER_CODE=

# Absolute site URL (canonical links + sitemap). Change when you add a custom domain.
VITE_SITE_URL=https://churious.github.io/pokenow/

# Report forms without a GitHub account (see worker/README.md). Both are needed;
# without them the site links to the GitHub issue forms.
VITE_REPORT_URL=
VITE_TURNSTILE_SITEKEY=
