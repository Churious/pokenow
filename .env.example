# Copy to `.env.local` and fill in. All values are optional.

# Repository link shown in the footer.
VITE_GITHUB_URL=https://github.com/Churious/pokespot

# Google AdSense publisher id. Leave empty in development: ad slots render
# labelled placeholders and the AdSense script is never requested.
VITE_ADSENSE_CLIENT=
# Ad unit slot ids (numbers from AdSense → Ads → By ad unit).
VITE_AD_SLOT_TOP=
VITE_AD_SLOT_INFEED=
VITE_AD_SLOT_ANCHOR=
# In-feed units require the layout key shown in the AdSense code snippet.
VITE_AD_INFEED_LAYOUT_KEY=

# Absolute site URL (canonical links + sitemap). Change when you add a custom domain.
VITE_SITE_URL=https://churious.github.io/pokespot/
